{
  "name": "asperfcc",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace de estudo de alta performance para o concurso TCE-GO 2026 (FCC) — Técnico de Controle Externo, especialidade TI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bank:validate": "tsx scripts/bank-validate.ts",
    "bank:stats": "tsx scripts/bank-stats.ts",
    "bank:new-lote": "tsx scripts/bank-new-lote.ts",
    "contraste": "tsx scripts/contraste.ts",
    "gerar": "tsx scripts/gerar.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
